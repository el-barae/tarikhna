# Local JSON persistence is used when DATABASE_URL is empty.
# PostgreSQL/PostGIS (including Neon): use the connection string from the provider.
# DATABASE_URL=postgres://athar:change-me@localhost:5433/athar
# Neon (copy the full URL, keep sslmode=require):
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# HISTORY_STORE_PATH=./data/.store.json
# Mobile wrapper: URL reachable from the device
# EXPO_PUBLIC_WEB_URL=https://atlas.example.org

# Set this to the exact public origin when deployed behind a proxy.
# APP_ORIGIN=http://localhost:3000
# TRUST_PROXY=false

# Set to true to disable authentication entirely (local/demo use only):
# every request then acts as a local administrator.
# DISABLE_AUTH=false

# Assistant: Amazon Bedrock + the public Makteb MCP endpoint.
# See docs/ASSISTANT.md. Keep these variables server-side (no NEXT_PUBLIC_).
AWS_REGION=
BEDROCK_MODEL_ID=
# Example: global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Alternative: global.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional: set false to disable Makteb/MCP and use Bedrock-only answers (without external sources).
# ASSISTANT_USE_MCP=false
# Optional: set false to let visitors use the assistant without signing in (other app features stay protected).
# ASSISTANT_REQUIRE_LOGIN=false
# Use your AWS profile/IAM role, or supply credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# Or a Bedrock API key (takes precedence if set):
# AWS_BEARER_TOKEN_BEDROCK=
